{
	"name": "@benheidenreich/n8n-nodes-autocrm",
	"version": "0.1.0",
	"description": "n8n community node for autocrm (IMAGO Informationstechnologie): create leads, assign them to branches, categories and employees, attach emails and notes, and check lead existence via the autocrm API3",
	"keywords": [
		"n8n-community-node-package",
		"autocrm",
		"crm",
		"lead-management",
		"leads",
		"automotive",
		"dealership"
	],
	"license": "MIT",
	"homepage": "https://github.com/benheidenreich/n8n-nodes-autocrm",
	"author": {
		"name": "Benjamin Heidenreich",
		"email": "ben.heidenreich.mail+n8n@googlemail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/benheidenreich/n8n-nodes-autocrm.git"
	},
	"engines": {
		"node": ">=18.10"
	},
	"main": "dist/nodes/AutoCrm/AutoCrm.node.js",
	"scripts": {
		"build": "tsc && node scripts/copy-assets.js",
		"dev": "tsc --watch",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint",
		"test": "npm run build && node test/run-tests.mjs"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AutoCrmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AutoCrm/AutoCrm.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^20.14.0",
		"@typescript-eslint/parser": "^7.15.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"n8n-workflow": "*",
		"typescript": "^5.5.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
