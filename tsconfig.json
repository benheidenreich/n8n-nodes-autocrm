{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"declaration": true,
		"sourceMap": true,
		"outDir": "./dist/",
		"esModuleInterop": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["credentials/**/*", "nodes/**/*", "package.json"]
}
