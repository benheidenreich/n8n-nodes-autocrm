{
	"name": "autocrm example: create and assign a lead",
	"nodes": [
		{
			"parameters": {
				"content": "## autocrm example workflow\n\n**⚠️ Running the upper branch creates a REAL lead!**\n\nReplace first (autocrm support provides the values):\n- `BRANCH_ID` → your branch ID\n- `CATEGORY` → a valid category name or path `PARENT|CHILD`\n- `SOURCE_NAME` → a valid source\n- Employee Email → the employee's **external** dealership address (not their autocrm login!)\n\nThe two detached nodes below are harmless standalone examples:\n- **Exists** is read-only — ideal as a first connectivity test.\n- **Attach Email** shows the raw EML mode (it only documents, it sends nothing).",
				"height": 420,
				"width": 480
			},
			"id": "sticky-01",
			"name": "Sticky Note",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-260, -180]
		},
		{
			"parameters": {},
			"id": "trigger-01",
			"name": "When clicking \"Execute workflow\"",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [280, 0]
		},
		{
			"parameters": {
				"resource": "lead",
				"operation": "create",
				"contactId": "CRM-0001",
				"lastName": "Mustermann",
				"email": "max.mustermann@example.com",
				"branchId": "BRANCH_ID",
				"category": "CATEGORY",
				"firstContactChannel": "E-Mail",
				"source": "SOURCE_NAME",
				"noteTitle": "Message from the customer",
				"noteContent": "Please send me a quote.",
				"additionalContactFields": {
					"firstName": "Max",
					"phone": "+496301708123456"
				},
				"additionalLeadFields": {},
				"vehicle": {}
			},
			"id": "autocrm-create-01",
			"name": "Create lead",
			"type": "@benheidenreich/n8n-nodes-autocrm.autoCrm",
			"typeVersion": 1,
			"position": [500, 0]
		},
		{
			"parameters": {
				"resource": "lead",
				"operation": "assign",
				"leadId": "={{ $json[\"id-anfrage\"] }}",
				"assignTo": "employee",
				"employeeEmail": "salesperson@dealership.example",
				"branchId": "",
				"category": ""
			},
			"id": "autocrm-assign-01",
			"name": "Assign lead",
			"type": "@benheidenreich/n8n-nodes-autocrm.autoCrm",
			"typeVersion": 1,
			"position": [720, 0]
		},
		{
			"parameters": {
				"resource": "lead",
				"operation": "exists",
				"leadId": 12345
			},
			"id": "autocrm-exists-01",
			"name": "Exists (harmless read-only test)",
			"type": "@benheidenreich/n8n-nodes-autocrm.autoCrm",
			"typeVersion": 1,
			"position": [500, 260]
		},
		{
			"parameters": {
				"resource": "lead",
				"operation": "attachEmail",
				"leadId": 12345,
				"emlSource": "raw",
				"emlText": "MIME-Version: 1.0\nContent-Type: text/plain; charset=utf-8\nFrom: dealership@example.com\nTo: max.mustermann@example.com\nDate: Mon, 24 Aug 2026 12:00:00 +0200\nSubject: Your enquiry\n\nHello, thank you for your enquiry. We will get back to you shortly."
			},
			"id": "autocrm-attach-01",
			"name": "Attach Email (raw EML example)",
			"type": "@benheidenreich/n8n-nodes-autocrm.autoCrm",
			"typeVersion": 1,
			"position": [720, 260]
		}
	],
	"connections": {
		"When clicking \"Execute workflow\"": {
			"main": [
				[
					{
						"node": "Create lead",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Create lead": {
			"main": [
				[
					{
						"node": "Assign lead",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"active": false,
	"settings": {},
	"pinData": {}
}
